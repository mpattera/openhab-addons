<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="kseniasecurity"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="panel">
		<label>Ksenia Security Panel</label>
		<description>The alarm control panel</description>
		<semantic-equipment-tag>AlarmSystem</semantic-equipment-tag>

		<channels>
			<channel id="systemLang" typeId="textStatusChannel">
				<label>System Language</label>
				<description>Language configured in the alarm panel</description>
			</channel>
			<channel id="sessionState" typeId="textStatusChannel">
				<label>Session State</label>
				<description>Programming session state (OPEN, PENDING or CLOSE)</description>
			</channel>
			<channel id="freezeState" typeId="textStatusChannel">
				<label>Freeze State</label>
				<description>System freeze state (OFF, ALARM or TOTAL)</description>
			</channel>
			<channel id="firmwareVersion" typeId="textStatusChannel">
				<label>Firmware Version</label>
				<description>Firmware version of the alarm panel</description>
			</channel>
			<channel id="webserverVersion" typeId="textStatusChannel">
				<label>Webserver Version</label>
				<description>Webserver version of the alarm panel</description>
			</channel>
		</channels>

		<config-description>
			<parameter name="host" type="text" required="true">
				<label>Host</label>
				<description>IP address or hostname for connection</description>
				<default>192.168.2.97</default>
			</parameter>
			<parameter name="port" type="integer" required="true">
				<label>Port</label>
				<description>TCP port for connection</description>
				<default>443</default>
			</parameter>
			<parameter name="useSSL" type="boolean" required="true">
				<label>Use SSL</label>
				<description>Use secure protocol to establish the connection</description>
				<default>true</default>
			</parameter>
			<parameter name="reconnectInterval" type="integer" required="true">
				<label>Reconnect interval</label>
				<description>Seconds to wait before a reconnection attempt can occur</description>
				<default>60</default>
			</parameter>
			<parameter name="loginType" type="text" required="true">
				<label>Login type</label>
				<description>Login type (IP_SUPERV or USER)</description>
				<default>IP_SUPERV</default>
			</parameter>
			<parameter name="pin" type="text" required="true">
				<label>PIN</label>
				<description>Login PIN</description>
				<context>password</context>
				<default>123456</default>
			</parameter>
		</config-description>
	</bridge-type>

	<channel-type id="textStatusChannel">
		<item-type>String</item-type>
		<label>Text</label>
		<description>Generic text status channel</description>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>
